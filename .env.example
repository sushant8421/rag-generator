PORT=3000

# ChromaDB (docker compose up -d)
CHROMA_URL=http://localhost:8000

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Retrieval
TOP_K=5
# When no section is chosen, also answer from sections within this distance of the best match
ROUTING_MARGIN=0.04

# Upload limits (checked at upload time)
MAX_PDF_PAGES=100
MAX_PDF_BYTES=20971520
MAX_TEXT_BYTES=307200
MAX_FILES_PER_UPLOAD=10

# Background ingestion jobs running at once
INGEST_CONCURRENCY=2

# Gemini (used for both embeddings and answers)
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
GENERATION_MODEL=gemini-3.8-flash
# LOW | MEDIUM | HIGH, or empty for the model default
GENERATION_THINKING_LEVEL=LOW
