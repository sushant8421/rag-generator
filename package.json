{
  "name": "rag-generator",
  "version": "1.0.0",
  "description": "Runtime RAG generator: upload documents into collections and ask grounded questions",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "chroma:up": "docker compose up -d chroma"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.27.0",
    "chromadb": "^3.5.0",
    "dompurify": "^3.4.16",
    "express": "^5.2.1",
    "marked": "^18.0.14",
    "multer": "^2.4.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
